# Copy to .env (docker compose reads it) or export in your shell.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/p1_rag

# Embeddings: hash (offline default) | fastembed (uv sync --extra fastembed) | openai (uv sync --extra openai)
EMBEDDER=hash
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Generation: fake (offline, default when no key) | anthropic
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-5-5
